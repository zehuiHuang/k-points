		if result != test.expected {
			t.Errorf("Test case %d (%s) failed: coinChange(%v, %d) = %d, expected %d",
				i, test.desc, test.coins, test.amount, result, test.expected)
		}
	}
}

func TestNumDecodings(t *testing.T) {
	tests := []struct {
		s        string
		expected int
		desc     string
	}{
		{
			s:        "12",
			expected: 2, // "AB" (1 2) or "L" (12)
			desc:     "两位数编码",
		},
		{
			s:        "226",
			expected: 3, // "BZ"(2 26), "VF"(22 6), "BBF"(2 2 6)
			desc:     "多位编码",
		},
		{
			s:        "06",
			expected: 0, // "06"不能映射
			desc:     "含前置0",
		},
		{
			s:        "1201234",
			expected: 0, // 由于"0"的存在
			desc:     "中间含0",
		},
		{
			s:        "",
			expected: 1, // 空字符串1种方式
			desc:     "空字符串",
		},
	}

	for i, test := range tests {
		result := numDecodings(test.s)
		if result != test.expected {
			t.Errorf("Test case %d (%s) failed: numDecodings(%q) = %d, expected %d",
				i, test.desc, test.s, result, test.expected)
		}
	}
}

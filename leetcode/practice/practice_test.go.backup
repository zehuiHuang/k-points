func TestLongestPalindromicSubseq(t *testing.T) {
	tests := []struct {
		s        string
		expected int
		desc     string
	}{
		{
			s:        "bbbab",
			expected: 4, // "bbbb"
			desc:     "最长回文子序列1",
		},
		{
			s:        "cbbd",
			expected: 2, // "bb"
			desc:     "最长回文子序列2",
		},
		{
			s:        "a",
			expected: 1, // 单字符本身就是回文
			desc:     "单字符",
		},
		{
			s:        "",
			expected: 0, // 空字符串
			desc:     "空串",
		},
		{
			s:        "abc",
			expected: 1, // 任选一个字符
			desc:     "无重复字符",
		},
		{
			s:        "aabaa",
			expected: 5, // 整个字符串是回文
			desc:     "整个字符串为回文",
		},
	}

	for i, test := range tests {
		result := longestPalindromeSubseq(test.s)
		if result != test.expected {
			t.Errorf("Test case %d (%s) failed: longestPalindromeSubseq(%q) = %d, expected %d",
				i, test.desc, test.s, result, test.expected)
		}
	}
}

